# Copy this file to `.env` in the project root, then fill in real values:
#   cp .env.example .env
#
# `.env` is gitignored — never commit secrets.
# docker compose reads this file for the `server` and `client` services.

# --- Postgres (used by the official postgres image + DATABASE_URL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jobtracker

# --- Clerk (auth) ---
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Vite only exposes env vars prefixed with VITE_ to the browser bundle.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# --- AI providers ---
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=...

# --- Frontend → API (browser calls this URL on YOUR machine) ---
VITE_API_URL=http://localhost:3001
