{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "node"],
  "categories": { "correctness": "error" },
  "rules": {
    // A promise that is never awaited or caught is a silent bug (e.g. a database write that fails unnoticed)
    "typescript/no-floating-promises": "error",
    // await on something that is not a promise is almost always a mistake
    "typescript/await-thenable": "error",
    // Express 5 handles async route handlers, so passing one is fine; the other checks (like `if (promise)`) stay on
    "typescript/no-misused-promises": ["error", { "checksVoidReturn": false }]
  },
  "overrides": [
    {
      // repositories/listings has no userId (shared data), so a route calling it would skip every ownership check
      "files": ["src/routes/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["**/repositories/listings*"], "message": "listings is shared data with no userId; only the fetch job may import it, never a route." },
              { "group": ["**/repositories/similarity*"], "message": "similarity is job-only (it compares every user's resume) and has no userId; never import it from a route." },
              { "group": ["**/embeddings", "**/embeddings/*", "**/boards", "**/boards/*", "**/runDailyJob*"], "message": "the fetch and embedding code is for the daily job only (it spends money and calls other servers); never import it from a route." }
            ]
          }
        ]
      }
    }
  ]
}
